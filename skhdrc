# focus window (vim keys)
cmd - h : yabai -m window --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east

# switch spaces
cmd - f : ~/.config/yabai/focus-space.sh 1
cmd - u : ~/.config/yabai/focus-space.sh 2
cmd - p : ~/.config/yabai/focus-space.sh 3
cmd - n : ~/.config/yabai/focus-space.sh 4
cmd - e : ~/.config/yabai/focus-space.sh 5
cmd - r : ~/.config/yabai/focus-display.sh next
cmd - i : ~/.config/yabai/focus-space.sh 7

# send focused window to space
shift + cmd - f : yabai -m window --space 1
shift + cmd - u : yabai -m window --space 2
shift + cmd - p : yabai -m window --space 3
shift + cmd - n : yabai -m window --space 4
shift + cmd - e : yabai -m window --space 5

# toggle fullscreen
cmd - i : ~/.config/yabai/focus-space.sh 7

# toggle float
shift + cmd - t : yabai -m window --toggle float

# balance windows (was shift+cmd-e, conflicts with space 5 — rebind if desired)
# shift + cmd - e : yabai -m space --balance

# rotate layout
shift + cmd - r : yabai -m space --rotate 270

# close window
shift + cmd - q : yabai -m window --close
