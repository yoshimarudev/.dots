font-family = IosevkaTerm Nerd Font
font-size = 18
background = #181818
window-padding-y = 3
window-padding-x = 3
window-padding-balance = true
mouse-hide-while-typing = true
adjust-cell-height = 4
font-feature = -calt, -liga, -dlig
window-padding-color = background

# Stop Ghostty auto-enabling macOS Secure Keyboard Entry on password-prompt
# heuristics — it gets stuck "on" and blocks skhd/yabai hotkeys session-wide.
macos-auto-secure-input = false
